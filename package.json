{
  "name": "clyde",
  "version": "1.0.0-beta.18",
  "description": "Electron app for real-time meeting transcription.",
  "main": "main.js",
  "scripts": {
    "prestart": "node ./scripts/generate-icon.js && node ./scripts/cleanup-electron-cache.js && electron-builder install-app-deps && (electron-rebuild -f -w better-sqlite3 || echo Rebuild skipped)",
    "start": "npm run renderer:build && node ./scripts/start-electron.js",
    "renderer:build": "vite build",
    "renderer:dev": "vite --host 127.0.0.1",
    "audio-engine:build": "node ./scripts/build-audio-engine.js",
    "audio-engine:test": "cargo test --manifest-path ./native/audio-engine/Cargo.toml",
    "electron:native:rebuild": "electron-rebuild -f -w better-sqlite3",
    "release:check": "npm test && npm run renderer:build && npm run audio-engine:build && npm run pack",
    "prepack": "node ./scripts/generate-icon.js && npm run audio-engine:build && npm run renderer:build && npm run electron:native:rebuild",
    "whisper": "powershell -ExecutionPolicy Bypass -File ./scripts/start-whisper-server.ps1",
    "whisper:cpu": "powershell -ExecutionPolicy Bypass -File ./scripts/start-whisper-server.ps1 -Runtime cpu",
    "audio:check": "node ./scripts/check-audio-sources.js",
    "pretest": "npm rebuild better-sqlite3",
    "test": "node --test",
    "pack": "node ./scripts/build-outside-onedrive.js --dir",
    "predist": "node ./scripts/generate-icon.js && npm run audio-engine:build && npm run renderer:build && npm run electron:native:rebuild",
    "dist": "node ./scripts/build-outside-onedrive.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@heygen/liveavatar-web-sdk": "^0.0.18",
    "@pinecone-database/pinecone": "^7.2.0",
    "@playwright/mcp": "^0.0.75",
    "axios": "^1.16.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "native-audio-node": "^0.3.5",
    "node-record-lpcm16": "^1.0.1",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.61.0-alpha-1778188671000",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.6.1",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.clyde.app",
    "productName": "Clyde",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName} Setup v${version}.${ext}",
    "asar": true,
    "files": [
      "main.js",
      "package.json",
      "src/**/*.js",
      "src/renderer-dist/**/*",
      "clyde*.svg",
      "clyde_*.svg",
      "!src/renderer{,/**/*}",
      "!test{,/**/*}",
      "!website{,/**/*}",
      "!dist{,/**/*}",
      "!dist-pack{,/**/*}",
      "!native{,/**/*}",
      "!logs{,/**/*}",
      "!tmp{,/**/*}",
      "!run-slate{,/**/*}",
      "!liveavatar-agent-skills{,/**/*}",
      "!output*.wav",
      "!output.html"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "azureSignOptions": {
        "publisherName": "Stephen Skalamera",
        "endpoint": "https://eus.codesigning.azure.net/",
        "certificateProfileName": "ClydeDesktop",
        "codeSigningAccountName": "Clyde-Desktop"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "appx": {
      "publisher": "CN=Stephen Skalamera",
      "publisherDisplayName": "Stephen Skalamera",
      "identityName": "Clyde",
      "applicationId": "Clyde",
      "displayName": "Clyde",
      "languages": [
        "en-US"
      ],
      "showNameOnTiles": true
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "native/audio-engine/target/release/clyde-audio-engine.exe",
        "to": "clyde-audio-engine.exe"
      },
      "scripts/**/*",
      "voicemeeter_banana_settings.xml"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://storage.googleapis.com/clydeai-live-downloads"
      }
    ]
  }
}
