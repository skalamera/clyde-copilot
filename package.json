  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@pinecone-database/pinecone": "^7.2.0",
    "axios": "^1.16.0",
    "dotenv": "^17.4.2",
    "electron": "^41.5.0",
    "node-record-lpcm16": "^1.0.1"
  },
  "devDependencies": {
    "electron-builder": "^12.0.0"
  }
}
