{
  "name": "clyde",
  "version": "1.0.0",
  "description": "Electron app for real-time meeting transcription.",
  "main": "main.js",
  "scripts": {
    "prestart": "node ./scripts/generate-icon.js && node ./scripts/cleanup-electron-cache.js && electron-builder install-app-deps",
    "start": "npm run renderer:build && node ./scripts/start-electron.js",
    "renderer:build": "vite build",
    "renderer:dev": "vite --host 127.0.0.1",
    "audio-engine:build": "node ./scripts/build-audio-engine.js",
    "audio-engine:test": "cargo test --manifest-path ./native/audio-engine/Cargo.toml",
    "prepack": "node ./scripts/generate-icon.js && npm run audio-engine:build && npm run renderer:build",
    "whisper": "powershell -ExecutionPolicy Bypass -File ./scripts/start-whisper-server.ps1",
    "whisper:cpu": "powershell -ExecutionPolicy Bypass -File ./scripts/start-whisper-server.ps1 -Runtime cpu",
    "audio:check": "node ./scripts/check-audio-sources.js",
    "pretest": "npm rebuild better-sqlite3",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "predist": "node ./scripts/generate-icon.js && npm run audio-engine:build && npm run renderer:build",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@pinecone-database/pinecone": "^7.2.0",
    "@playwright/mcp": "^0.0.75",
    "axios": "^1.16.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "native-audio-node": "^0.3.5",
    "node-record-lpcm16": "^1.0.1",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.61.0-alpha-1778188671000",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.6.1",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.clyde.app",
    "productName": "Clyde",
    "icon": "icon.png",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "native/audio-engine/target/release/clyde-audio-engine.exe",
        "to": "clyde-audio-engine.exe"
      },
      "scripts/**/*",
      "voicemeeter_banana_settings.xml"
    ],
    "publish": [
      "github"
    ]
  }
}
